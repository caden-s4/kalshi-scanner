data/
*.ndjson
*.ndjson.zst
*.parquet

# --- Local state / logs ---
backfill_state.db
*.db
*.log

# --- Python environment & caches ---
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

