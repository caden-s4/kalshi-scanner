# Copy this file to .env and fill in your values. Never commit the real .env.

# --- Required ---
# Kalshi API key ID (from your Kalshi account API settings).
KALSHI_KEY_ID=your-kalshi-api-key-id-here
# Absolute path to your Kalshi RSA private key (PEM). Keep this file OUTSIDE the repo.
KALSHI_PEM_PATH=/absolute/path/to/kalshi-private-key.pem

# --- Optional (defaults shown) ---
# Directory where captured data is written.
KALSHI_DATA_DIR=data
# Comma-separated WS channels to subscribe to.
KALSHI_CHANNELS=ticker,trade
# Comma-separated ticker prefixes to filter on. Empty means record everything.
KALSHI_TICKER_PREFIXES=
# Disk-space guard thresholds, in GiB of free space on the data volume.
MIN_FREE_GB_START=5
MIN_FREE_GB_HALT=2
# Retention: minimum age (days) before a compacted raw hour is eligible for deletion.
RETENTION_MIN_AGE_DAYS=7
