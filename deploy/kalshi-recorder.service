[Unit]
Description=Kalshi market-data recorder
Documentation=file:/home/kalshi/kalshi-scanner/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Do not start until the data volume is mounted; systemd derives the mount unit
# dependency from this path and stops the service if the mount goes away.
RequiresMountsFor=/mnt/kalshi
# Never give up retrying transient failures (network outages self-heal); rely on
# the backoff below instead of the start-limit burst to avoid hot-looping. This
# is a [Unit] directive.
StartLimitIntervalSec=0

[Service]
Type=exec
User=kalshi
Group=kalshi
WorkingDirectory=/home/kalshi/kalshi-scanner
# run_recorder.py supervises recorder.py and maps an intentional disk-space halt
# to exit code 75 (see RestartPreventExitStatus below).
ExecStart=/home/kalshi/kalshi-scanner/.venv/bin/python /home/kalshi/kalshi-scanner/run_recorder.py

# Restart on crash with growing backoff, but NEVER restart on an intentional
# disk-space halt (exit 75) -- restarting into a full disk is pointless and the
# recorder would immediately refuse to start again.
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=300

# Allow the recorder to drain its queue and flush the final zstd frame on stop.
TimeoutStopSec=120
KillSignal=SIGTERM

# Memory containment on a 1 GB box. Three tiers, deliberately ordered:
#
#   1. recorder.py RSS_HALT_MB (400M, in-process)  -- PRIMARY. Trips the normal
#      clean-shutdown path, so the queue drains and the zstd tail frame is
#      flushed before exit(76). systemd then restarts us.
#   2. MemoryHigh (512M)  -- cgroup v2 memory.high. A *soft* limit: the kernel
#      throttles allocation and reclaims harder, but never kills. Buys headroom
#      if tier 1 is somehow late.
#   3. MemoryMax (768M)   -- cgroup v2 memory.max. A *hard* limit: on breach the
#      kernel cgroup OOM killer sends SIGKILL, which CANNOT be trapped, so the
#      clean-shutdown path does NOT run and the in-flight zstd frame is
#      truncated. That is the data loss we are trying to avoid, so this is a
#      last-resort backstop only -- it sits ABOVE tier 1 precisely so the
#      in-process guard always fires first.
#
# MemorySwapMax=0 keeps a leak from thrashing swap into a slow death where the
# recorder is alive but too stalled to keep up with the socket.
MemoryAccounting=yes
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kalshi-recorder

# Hardening (code lives under /home/kalshi, data under /mnt/kalshi).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/mnt/kalshi

[Install]
WantedBy=multi-user.target
